# Compliance agent connection (for /health/all only)
COMPLIANCE_SERVICE_URL=http://agent-compliance:8002
COMPLIANCE_HEALTH_TIMEOUT_SECONDS=3.0

# Groq LLM (primary) — free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.1-70b-versatile
GROQ_TIMEOUT_SECONDS=30.0
GROQ_MAX_RETRIES=2
GROQ_MAX_TOKENS=2048

# Gemini LLM (fallback) — free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=30.0

# Production hardening
REPORT_RATE_LIMIT=10/minute

# Logging
LOG_LEVEL=INFO
